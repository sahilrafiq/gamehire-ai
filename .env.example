# Copy this file to .env and fill in your own values.
# Never commit your real .env file.

# --- AI backend -------------------------------------------------------
# "ollama"    (default) fully local, zero API cost, nothing leaves your machine.
# "anthropic" Claude API -- costs a small amount per call, no local hardware needed.
AI_PROVIDER=ollama

# Used only when AI_PROVIDER=ollama. Run `ollama pull <model>` first.
# See README.md for hardware-tiered model recommendations.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Used only when AI_PROVIDER=anthropic. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_key_here

# Optional. Free tier at https://developer.adzuna.com
# Without these, job search still works via Remotive (remote jobs, no key needed).
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

JOOBLE_API_KEY=your_jooble_api_key

# --- Auto-Apply credentials (Tab 5) -----------------------------------
# These are used by the Playwright-based auto-apply automation.
# NEVER commit these to git. They stay local on your machine.
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

INDEED_EMAIL=your_indeed_email@example.com
INDEED_PASSWORD=your_indeed_password

# Personal info for auto-filling application forms
FIRST_NAME=Your
LAST_NAME=Name
PHONE_NUMBER=+1234567890
APPLY_EMAIL=your@email.com
